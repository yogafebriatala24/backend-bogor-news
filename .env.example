NODE_ENV=development
PORT=3001
APP_HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/db-news
REDIS_CACHE_URL=redis://127.0.0.1:6379/0
# Reserved for Phase 2 BullMQ; not connected by Phase 1.
REDIS_QUEUE_URL=redis://127.0.0.1:6379/1
REDIS_PREFIX=media:development:db-news
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=49000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=db-news
MAX_UPLOAD_BYTES=10485760
# Optional; required only when running npm run seed:admin
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password-at-least-12-characters
